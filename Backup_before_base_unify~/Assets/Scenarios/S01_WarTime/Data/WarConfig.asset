  act6EndingDelaySeconds: 14
  rescueLines:
  - "\uC5EC\uAE30\uB294 \uB2E4\uAD6D\uC801 \uC778\uB3C4\uC9C0\uC6D0\uB2E8\uC785\uB2C8\uB2E4. \uC0DD\uC874\uC790 \uC5EC\uB7EC\uBD84, \uB4E4\uB9AC\uC2ED\uB2C8\uAE4C? \uAD6C\uC870\uB300\uAC00 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
  - "\uCC3D\uBB38\uC744 \uC5F4\uC9C0 \uB9C8\uC2DC\uACE0, \uB9C8\uC2A4\uD06C\uB098 \uC816\uC740 \uC218\uAC74\uC73C\uB85C \uC785\uACFC \uCF54\uB97C \uAC00\uB9B0 \uCC44 \uC9C0\uC2DC\uB97C \uAE30\uB2E4\uB9AC\uC2ED\uC2DC\uC624."
  - "\uC774\uAC83\uC740 \uBC29\uC1A1\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uC9C0\uAE08, \uAC74\uBB3C \uC704\uC5D0 \uAD6C\uC870 \uD5EC\uAE30\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
