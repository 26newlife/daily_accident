  act1LimitSeconds: 80
  act1ToAct2DelaySeconds: 3
  alertPopupSeconds: 7
  lightSwayIntervalSeconds: 9
  alertText: "[\uD589\uC815\uC548\uC804\uBD80] \uC2E4\uC81C\uC0C1\uD669. \uC801\uC758 \uC804\uBA74 \uB0A8\uCE68 \uD655\uC778. \uC989\uC2DC \uC9C0\uD558 \uB300\uD53C\uC18C\uB85C \uC774\uB3D9\uD558\uACE0 \uC0DD\uD544\uD488\uC744 \uD655\uBCF4\uD558\uC2ED\uC2DC\uC624."
  alertSender: "\uD589\uC815\uC548\uC804\uBD80"
  act1Beats:
  - time: 6
    kind: 2
    text: "\uCC3D\uBC16\uC5D0\uC11C \uBBFC\uBC29\uC704 \uC0AC\uC774\uB80C\uC774 \uAE38\uAC8C \uC6B8\uB9B0\uB2E4."
    seconds: 4
  - time: 18
    kind: 2
    text: "\uAD49\uC74C\uACFC \uD568\uAED8 \uC804\uD22C\uAE30\uAC00 \uAC74\uBB3C \uC704\uB97C \uB0AE\uAC8C \uC2A4\uCCD0 \uC9C0\uB098\uAC04\uB2E4."
    seconds: 4
  - time: 40
    kind: 0
    text: "\uBCF5\uB3C4\uC5D0\uC11C \uC0AC\uB78C\uB4E4\uC774 \uB6F0\uC5B4\uB2E4\uB2C8\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    seconds: 4
  - time: 60
    kind: 2
    text: "\uB610 \uD55C \uBC88, \uB354 \uAC00\uAE4C\uC6B4 \uACF3\uC5D0\uC11C \uC804\uD22C\uAE30 \uC18C\uB9AC\uAC00 \uC3DF\uC544\uC9C4\uB2E4. \uC11C\uB458\uB7EC\uC57C \uD55C\uB2E4."
    seconds: 4
  act2LimitSeconds: 240
  actionPoints: 12
  inflationPerMinute: 0.35
  cashDecayPerMinute: 0.12
  cashValueFloor: 0.35
