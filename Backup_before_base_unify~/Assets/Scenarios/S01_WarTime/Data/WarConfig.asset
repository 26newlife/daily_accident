  channels:
  - name: "\uACF5\uC2DD \uBC29\uC1A1"
    label: AM 1,134 kHz
    clueId: 
    lines:
    - "\uAD6D\uBC29\uBD80 \uACF5\uC2DD \uBC1C\uD45C\uC785\uB2C8\uB2E4. \uC804\uC120\uC740 \uD604\uC7AC \uC548\uC815\uD654 \uB2E8\uACC4\uC5D0 \uB4E4\uC5B4\uC130\uC73C\uBA70, \uC2DC\uBBFC \uC5EC\uB7EC\uBD84\uC740 \uB3D9\uC694\uD558\uC9C0 \uB9C8\uC2DC\uACE0 \uC9C0\uCE68\uC5D0 \uB530\uB77C \uC8FC\uC2ED\uC2DC\uC624."
    - "\uC218\uB3C4\uAD8C \uBC29\uC5B4\uC120\uC740 \uAD73\uAC74\uD788 \uC720\uC9C0\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC720\uC5B8\uBE44\uC5B4\uC5D0 \uD604\uD639\uB418\uC9C0 \uB9C8\uC2ED\uC2DC\uC624."
  - name: "\uB2E8\uD30C A"
    label: SW 7.45 MHz
    clueId: clue_defense_collapse
    lines:
    - "\u2026\u2026\uCE58\uC9C1\u2026\u2026\uC218\uB3C4\uAD8C \uBC29\uC5B4\uC120\uC774 \uBB34\uB108\uC84C\uB2E4. \uBC18\uBCF5\uD55C\uB2E4, \uBD81\uBD80 \uBC29\uC5B4\uC120 \uBD95\uAD34\u2026\u2026\uCE58\uC9C1\u2026\u2026"
    - "\u2026\u2026\uD6C4\uBC29 \uC9C0\uD718\uBD80\uAC00 \uCCA0\uC218 \uC911\uC774\uB2E4. \uACF5\uC2DD \uBC1C\uD45C\uB97C \uBBFF\uC9C0 \uB9C8\uB77C\u2026\u2026\uCE58\uC9C1\u2026\u2026"
  - name: "\uB2E8\uD30C B"
    label: SW 11.20 MHz
    clueId: clue_special_weapon
    lines:
    - "\u2026\u2026\uCE58\uC9C1\u2026\u2026\uD2B9\uC218 \uBB34\uAE30 \uC6B4\uBC18 \uCC28\uB7C9\uC774 \uB3C4\uC2DC \uC678\uACFD\uC5D0\uC11C \uBAA9\uACA9\uB418\uC5C8\uB2E4. \uC774\uB3D9 \uC815\uD669\uC774 \uD655\uC2E4\uD558\uB2E4\u2026\u2026"
    - "\u2026\u2026\uC9C0\uD558\uB098 \uBC29\uD638 \uC2DC\uC124\uC5D0 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC740 \uC808\uB300 \uBC16\uC73C\uB85C \uB098\uAC00\uC9C0 \uB9C8\uB77C\u2026\u2026\uCE58\uC9C1\u2026\u2026"
  - name: "\uB2E8\uD30C C"
    label: SW 4.80 MHz
    clueId: 
    lines:
    - "\u2026\u2026\uCE58\uC774\uC774\uC774\uC774\uC774\uC774\u2026\u2026(\uC7A1\uC74C\uBFD0\uC774\uB2E4. \uB204\uAD70\uAC00\uC758 \uC228\uC18C\uB9AC \uAC19\uC740 \uAC83\uC774 \uC11E\uC5EC \uC788\uB2E4.)\u2026\u2026"
  withdrawalClueText: "\uB3C4\uB85C\uB97C \uB2EC\uB9AC\uB294 \uAD70\uC6A9 \uD2B8\uB7ED \uD589\uB82C\uC774 \uBAA8\uB450 \uD6C4\uBC29 \uCABD\uC73C\uB85C \uD5A5\uD558\uACE0 \uC788\uB2E4. \uCCA0\uC218\uD558\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC778\uB2E4."
  offers:
  - id: offer_water_food
