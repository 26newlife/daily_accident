  arm: {fileID: 579281534}
  elevatorStandPoint: {fileID: 1886569902}
  buttonAudio: {fileID: 1823651548}
  pressLines:
  - "\uC65C \uC774\uB807\uAC8C \uC548 \uC624\uC9C0\u2026 \uC5D8\uB9AC\uBCA0\uC774\uD130\uAC00 \uC548 \uC640\uC694."
  - "(\uB538\uAE4D, \uB538\uAE4D) \uC544\uC774\uACE0, \uBD88\uC774 \uB0AC\uB2E4\uB294\uB370 \uC65C \uC548 \uC624\uB294 \uAC70\uC57C."
  - "\uCF5C\uB85D, \uCF5C\uB85D\u2026 \uBE68\uB9AC \uB0B4\uB824\uAC00\uC57C \uD558\uB294\uB370."
  persuadedLine: "\uACC4\uB2E8\uC73C\uB85C\uC694? \u2026\uC54C\uC558\uC5B4\uC694. \uAC19\uC774 \uAC00\uC694."
  towelThanksLine: "\uC774\uAC78 \uC785\uC5D0 \uB300\uB77C\uACE0\uC694? \uACE0\uB9C8\uC6CC\uC694, \uC80A\uC740\uC774."
  waitLine: "\uAE30\uB2E4\uB824\uC918\uC694\u2026 \uB09C \uBE68\uB9AC \uBABB \uAC78\uC5B4\uC694."
  panicLine: "\uC548 \uB418\uACA0\uC5B4, \uC800\uAC70\uB77C\uB3C4 \uD0C0\uC57C\uC9C0!"
  boardedMessage: "\uC5D8\uB9AC\uBCA0\uC774\uD130 \uBB38\uC774 \uB2EB\uD614\uB2E4. \uC7A0\uC2DC \uB4A4 \uAE30\uACC4\uAC00 \uBA48\uCD94\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4\u2026"
  fallenLine: "(\uC228\uC774 \uAC00\uC05C \uC18C\uB9AC) \uB3C4\uC640\u2026 \uC918\uC694\u2026"
  liftedLine: "\uACE0\uB9C8\uC6CC\uC694\u2026 \uC5EC\uAE30\uC11C \uB098\uAC00\uC694."
  collapsedMessage: "\uD560\uBA38\uB2C8\uAC00 \uC5F0\uAE30\uC5D0 \uC758\uC2DD\uC744 \uC783\uACE0 \uC4F0\uB7EC\uC84C\uB2E4."
