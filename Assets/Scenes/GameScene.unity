  m_Script: {fileID: 11500000, guid: 682defb4c5e10ce49a9542bd4c926488, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameGameplay.Call119Controller
  phone: {fileID: 0}
  callActionId: call_119
  dispatcherTitle: "119 \uC0C1\uD669\uC2E4"
  promptBody: "\"119\uC785\uB2C8\uB2E4. \uC5B4\uB514\uC11C \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uC2E0\uAC00\uC694? \uC815\uD655\uD55C \uC704\uCE58\uB97C \uB9D0\uC500\uD574 \uC8FC\uC138\uC694.\""
  correctLocation: "1004\uD638 \uB300\uD53C\uACF5\uAC04 (10\uCE35)"
  wrongLocations:
  - "10\uCE35 \uBCF5\uB3C4 \uCABD\uC774\uC5D0\uC694"
  - "1004\uD638\uC694\u2026 \uBA87 \uCE35\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC5B4\uC694"
  - "\uC77C\uB2E8 \uBD88\uC774 \uB0AC\uC5B4\uC694, \uBE68\uB9AC \uC640 \uC8FC\uC138\uC694!"
  correctReply: "\"1004\uD638 \uB300\uD53C\uACF5\uAC04\uC774\uC2DC\uAD70\uC694. \uAD6C\uC870\uB300\uAC00 \uCD9C\uB3D9\uD569\uB2C8\uB2E4. \uBC29\uD654\uBB38\uC744 \uB2EB\uACE0 \uBB38\uD2C8\uC744 \uB9C9\uC740 \uCC44 \uAE30\uB2E4\uB9AC\uC138\uC694.\""
  wrongReply: "\"\uC704\uCE58\uB97C \uC815\uD655\uD788 \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC77C\uB2E8 \uCD9C\uB3D9\uD558\uC9C0\uB9CC \uC2DC\uAC04\uC774 \uB354 \uAC78\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC00\uB2A5\uD558\uBA74 \uB2E4\uC2DC \uC54C\uB824 \uC8FC\uC138\uC694.\""
  alreadyCalledMessage: "\uC774\uBBF8 119\uC5D0 \uC2E0\uACE0\uD588\uB2E4."
