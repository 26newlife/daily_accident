  m_Script: {fileID: 11500000, guid: 69d14282938d50f49b5b4b491347212d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameGameplay.Act2_BlastAndSmoke
  actTitle: "8\uCE35\uC758 \uD3ED\uBC1C\uACFC \uC5F0\uC1C4 \uD654\uC7AC"
  actDescription: "\uC544\uB798\uCE35 \uD3ED\uBC1C\uB85C \uC778\uD55C 2\uCC28 \uD654\uC7AC\uB97C \uC9C4\uC555\uD558\uAC70\uB098 \uCC28\uB2E8\uD558\uACE0 \uD0C8\uCD9C\uC744 \uC900\uBE44\uD55C\uB2E4."
  stepIds: []
  explosionGameTime: 210
  minDelayAfterAct1: 6
  fireDelayAfterExplosion: 30
  corridorFireAfterExplosion: 120
  endAfterExplosion: 210
  nextActDelay: 3
  player: {fileID: 1812878907}
  gas: {fileID: 73689001}
  fireManager: {fileID: 73689003}
  initialFires:
  - {fileID: 2024355844}
  - {fileID: 876992956}
  corridorFire: {fileID: 1246077839}
  frontDoor: {fileID: 1227293084}
  glassToShatter:
  - {fileID: 1781149}
  - {fileID: 997217415}
  - {fileID: 362494279}
