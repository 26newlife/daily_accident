  smellText: "\uD76C\uBBF8\uD55C \uAC00\uC2A4 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4"
  smellStrongText: "\uAC00\uC2A4 \uB0C4\uC0C8\uAC00 \uC810\uC810 \uC9D9\uC5B4\uC9C4\uB2E4. \uBA38\uB9AC\uAC00 \uC5B4\uC9C0\uB7FD\uB2E4."
  smellStrongGas: 0.3
  announcementCues:
  - text: "\uAE34\uAE09 \uC548\uB0B4 \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uD604\uC7AC 10\uCE35 \uB77C\uC778 \uB3C4\uC2DC\uAC00\uC2A4 \uBC30\uAD00 \uC555\uB825 \uC774\uC0C1\uC73C\uB85C \uAC00\uC2A4 \uB204\uCD9C\uC774 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    seconds: 6.5
  - text: "\uC138\uB300 \uB0B4 \uD654\uAE30 \uBC0F \uC804\uAE30 \uC2A4\uC704\uCE58 \uC870\uC791\uC744 \uC989\uC2DC \uC911\uB2E8\uD558\uC2DC\uACE0"
    seconds: 4.5
  - text: "\uCC3D\uBB38\uC744 \uC5F4\uC5B4 \uD658\uAE30\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    seconds: 3.5
