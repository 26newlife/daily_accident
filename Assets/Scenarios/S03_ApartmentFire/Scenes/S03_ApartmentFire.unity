  m_Script: {fileID: 11500000, guid: b49aa14a060339841910aa5b3a80efce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Scenarios.S03::GameGameplay.Act3_FireSpreads
  actTitle: "\uBC88\uC9C0\uB294 \uD654\uC7AC"
  actDescription: "\uC5F0\uC1C4 \uD654\uC7AC, \uB300\uD53C \uACBD\uB85C\uB97C \uD310\uB2E8\uD55C\uB2E4."
  stepIds: []
  objectivePool:
  - {fileID: 11400000, guid: bd798185f5f385048adfc86c1bcbbb41, type: 2}
  - {fileID: 11400000, guid: 91780a189b4fb9f42be4fc014af8f458, type: 2}
  - {fileID: 11400000, guid: 2b0f0a7c9f896c3438c22a2024a294a5, type: 2}
  - {fileID: 11400000, guid: cd82085963b30c24bb60f015bf326fa2, type: 2}
  - {fileID: 11400000, guid: 6457b1fed39123348ae26959c78f3ea0, type: 2}
  - {fileID: 11400000, guid: 9f03ea7a836fbc346965bd71ea23f362, type: 2}
  - {fileID: 11400000, guid: 43ec9b4ccf38f6c44801d067f1902913, type: 2}
  - {fileID: 11400000, guid: 8a7c498fa546eec4399d6c9a86f53ee4, type: 2}
  - {fileID: 11400000, guid: e4e03b076c4deb24e88cc3b0d438499a, type: 2}
  - {fileID: 11400000, guid: 4a5930bff0cd49a43b6fccd357c6f9d6, type: 2}
  - {fileID: 11400000, guid: d9a02bc7d8dac3044bf5d185a4209384, type: 2}
  - {fileID: 11400000, guid: eb10c81e8ca479f40b4b903a23848603, type: 2}
  - {fileID: 11400000, guid: 260eca0e40466c94397430e96f4ce9a0, type: 2}
  - {fileID: 11400000, guid: de58bec7b36627e43876033ce6f68c6f, type: 2}
  - {fileID: 11400000, guid: da75ec60496ad344d9fbe3b67aacf4fe, type: 2}
  - {fileID: 11400000, guid: 4fcedbde74bdf3c4b99a6aabc73b9c0e, type: 2}
  - {fileID: 11400000, guid: 1ab0d82986a8532469c4860363f63a09, type: 2}
  - {fileID: 11400000, guid: 781c65cdadbc73c49ad142ea5c21ff74, type: 2}
  - {fileID: 11400000, guid: c92403c3e0f84f14f8ef088143e13666, type: 2}
  - {fileID: 11400000, guid: a3121bd9c7675674dbed06c2c9ab5a6c, type: 2}
  - {fileID: 11400000, guid: e6076efb80d0d364187ee5bfbdb1c65b, type: 2}
  - {fileID: 11400000, guid: 12a7e65ca69f1bc4c8612410aac44760, type: 2}
  - {fileID: 11400000, guid: 7462329392ca2a04db99bd2fca3ec951, type: 2}
  player: {fileID: 0}
  frontDoor: {fileID: 0}
  stairDoor: {fileID: 0}
  grandmother: {fileID: 1413254949}
  youngMan: {fileID: 181158410}
  corridorZone: {fileID: 0}
  stairZone: {fileID: 0}
  stairSmokeFx: {fileID: 488831843}
  stairRumbleAudio: {fileID: 589440884}
  peepholeNpcFlags:
  - act3_npc_corridor_1003
  - act3_npc_corridor_1002
  corridorEnterText: "\uBCF5\uB3C4\uB294 \uC5B4\uB461\uACE0 \uB9E4\uCE90\uD558\uB2E4. \uC5D8\uB9AC\uBCA0\uC774\uD130 \uCABD\uC5D0\uC11C \uAE30\uCE68 \uC18C\uB9AC\uC640 \uBC84\uD2BC \uB204\uB974\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
  frontClosedText: "\uD604\uAD00\uBB38\uC744 \uB2EB\uC558\uB2E4. \uC9D1 \uC548\uC758 \uC5F0\uAE30\uAC00 \uBCF5\uB3C4\uB85C \uC0C8\uC5B4 \uB098\uC624\uC9C0 \uC54A\uB294\uB2E4."
  stairClearText: "\uBC29\uD654\uBB38\uC744 \uC5F4\uC790 \uACC4\uB2E8\uC740 \uC544\uC9C1 \uB9D1\uB2E4. \uC5F0\uAE30\uAC00 \uC62C\uB77C\uC624\uAE30 \uC804\uC5D0 \uB0B4\uB824\uAC08 \uC218 \uC788\uB2E4!"
  stairSmokeText: "\uBC29\uD654\uBB38\uC744 \uC5F4\uC790 \uAC80\uC740 \uC5F0\uAE30\uC640 \uB728\uAC70\uC6B4 \uC5F4\uAE30\uAC00 \uACC4\uB2E8\uC744 \uD0C0\uACE0 \uC62C\uB77C\uC628\uB2E4! \uC544\uB798\uB85C\uB294 \uB0B4\uB824\uAC08 \uC218 \uC5C6\uB2E4."
  stairNpcOpenedText: "\uB204\uAD70\uAC00 \uACC4\uB2E8 \uBC29\uD654\uBB38\uC744 \uC5F4\uC5B4 \uB454 \uCC44 \uB0B4\uB824\uAC14\uB2E4. \uC5F4\uB9B0 \uBC29\uD654\uBB38\uC73C\uB85C \uC5F0\uAE30\uAC00 \uC0C8\uC5B4 \uB098\uC628\uB2E4."
  blockedText: "\uD604\uAD00\uBB38\uC774 \uB728\uAC81\uB2E4. \uBCF5\uB3C4\uB85C\uB294 \uB098\uAC08 \uC218 \uC5C6\uB2E4. \uC774\uC6C3\uC9D1 \uBE44\uBA85\uACFC \uC18C\uBC29 \uC0AC\uC774\uB80C\uC774 \uB4E4\uB9B0\uB2E4. \uC9D1 \uC548\uC5D0\uC11C \uBC84\uD2F8 \uBC29\uBC95\uC744 \uCC3E\uC790."
