  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69d14282938d50f49b5b4b491347212d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Scenarios.S03::GameGameplay.Act2_BlastAndSmoke
  actTitle: "8\uCE35\uC758 \uD3ED\uBC1C\uACFC \uC5F0\uC1C4 \uD654\uC7AC"
  actDescription: "\uC544\uB798\uCE35 \uD3ED\uBC1C\uB85C \uC778\uD55C 2\uCC28 \uD654\uC7AC\uB97C \uC9C4\uC555\uD558\uAC70\uB098 \uCC28\uB2E8\uD558\uACE0 \uD0C8\uCD9C\uC744 \uC900\uBE44\uD55C\uB2E4."
  stepIds: []
  flagAct1Timeout: act1_timeout
  player: {fileID: 0}
  gas: {fileID: 1308789215}
  fireManager: {fileID: 1308789216}
  initialFires:
  - {fileID: 1719046080}
  - {fileID: 759343890}
  corridorFire: {fileID: 2112714728}
  frontDoor: {fileID: 0}
  glassToShatter:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  brokenOpenings:
  - {fileID: 0}
  - {fileID: 0}
  glassShards: {fileID: 1751529661}
  explosionAudio: {fileID: 1789167292}
  exitLightGroupId: exit
  blackoutAmbient: 0.03
  shakeAmplitude: 0.14
  shakeSeconds: 3
  handleCheckId: door_handle_check
  frontDoorId: door_front
  extinguisherItemId: extinguisher
  wetTowelItemId: wet_towel
  spareTowelItemId: towel
  waterBottleItemId: water_bottle
  pinPulledEventId: extinguisher_pin_pulled
  fireAllOutEventId: fire_all_out
  objMain: {fileID: 11400000, guid: d7e8e18668271e14d9cd523bb994abbf, type: 2}
  objExtinguisher: {fileID: 11400000, guid: 5ac999612d0efff4692b20355283df80, type: 2}
  objSuppress: {fileID: 11400000, guid: d09be58794113fa49ba4a2d75ef19583, type: 2}
  objTowel: {fileID: 11400000, guid: 37a6028536a549f44ab242d5c8e12e98, type: 2}
  objBottle: {fileID: 11400000, guid: 89045ca801eca7d4daf60b930a21a8d3, type: 2}
  objHandle: {fileID: 11400000, guid: b361959da147a9a4782b1c0fdf9c096e, type: 2}
  explosionText: "\uCF85! \uC544\uB798\uCE35\uC5D0\uC11C \uAC70\uB300\uD55C \uD3ED\uBC1C\uC774 \uC77C\uC5B4\uB0AC\uB2E4. \uAC74\uBB3C\uC774 \uD754\uB4E4\uB9AC\uACE0 \uBD88\uC774 \uBAA8\uB450 \uAEBC\uC84C\uB2E4."
  fireText: "\uAE68\uC9C4 \uBCA0\uB780\uB2E4 \uCC3D\uC73C\uB85C \uBD88\uAE38\uC774 \uB4E4\uC5B4\uC640 \uCEE4\uD2BC\uACFC \uC8FC\uBC29 \uD32C\uC5D0 \uC62E\uACA8\uBD99\uC5C8\uB2E4!"
  smokeText: "\uAC80\uC740 \uC5F0\uAE30\uAC00 \uCC9C\uC7A5\uBD80\uD130 \uCC28\uC624\uB978\uB2E4. \uC790\uC138\uB97C \uB0AE\uCDB0\uC57C \uD55C\uB2E4."
  allOutText: "\uBD88\uAE38\uC744 \uBAA8\uB450 \uC7A1\uC558\uB2E4. \uC5F0\uAE30\uAC00 \uC11C\uC11C\uD788 \uAC77\uD78C\uB2E4."
  corridorFireText: "\uD604\uAD00 \uBC16\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uD0C0\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
  handleHotText: "\uC190\uB4F1\uC744 \uB300\uC790 \uBB38\uC190\uC7A1\uC774\uAC00 \uB728\uAC81\uB2E4! \uBCF5\uB3C4\uC5D0 \uBD88\uAE38\uC774 \uC788\uB2E4. \uD604\uAD00\uC73C\uB85C\uB294 \uB098\uAC08 \uC218 \uC5C6\uB2E4."
  handleCoolText: "\uBB38\uC190\uC7A1\uC774\uB294 \uBBF8\uC9C0\uADFC\uD558\uB2E4. \uBCF5\uB3C4\uC5D0\uB294 \uC544\uC9C1 \uBD88\uAE38\uC774 \uBC88\uC9C0\uC9C0 \uC54A\uC740 \uB4EF\uD558\uB2E4."
  hotDoorLockedMessage: "\uBB38\uC190\uC7A1\uC774\uAC00 \uB728\uAC81\uB2E4. \uC5F4\uBA74 \uBD88\uAE38\uC774 \uBC00\uB824\uB4E0\uB2E4."
  clearMessage: "Act 2 \uD074\uB9AC\uC5B4"
  smokeFloorRouteA: 0.04
  smokeFloorRouteB: 0.25
  doorBackdraftDeath: 10
  flagRoute: act2_route
  flagExtinguished: act2_fires_extinguished
  flagWetTowel: act2_wet_towel
  flagSpareTowel: act2_spare_towel
  flagBottle: act2_water_bottle
  flagCorridorHot: act2_corridor_hot
  flagFrontBlocked: act3_front_door_blocked
  flagHandleChecked: act2_handle_checked
