  m_Name: Death_ElevatorStallSmoke
  m_EditorClassIdentifier: Assembly-CSharp::GameGameplay.DeathReasonData
  reason: 18
  title: "\uC5D8\uB9AC\uBCA0\uC774\uD130 \uC815\uC9C0 \xB7 \uC9C8\uC2DD"
  whyYouDied: "\uD654\uC7AC \uC911 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294 \uC815\uC804\uACFC \uACE0\uC7A5\uC73C\uB85C \uB3C4\uC911\uC5D0 \uBA48\uCD9C \uC218 \uC788\uACE0, \uC5F0\uAE30\uC640 \uC5F4\uAE30\uAC00 \uC2B9\uAC15\uB85C\uB97C \uD0C0\uACE0 \uB4E4\uC5B4\uC635\uB2C8\uB2E4. \uAC07\uD78C \uC881\uC740 \uCE78 \uC548\uC5D0\uC11C \uC5F0\uAE30\uB97C \uB4E4\uC774\uB9C8\uC154 \uC9C8\uC2DD\uD588\uC2B5\uB2C8\uB2E4."
  correctAction: "\uD654\uC7AC\uAC00 \uB0AC\uC744 \uB54C\uB294 \uC808\uB300 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB97C \uD0C0\uC9C0 \uB9D0\uACE0 \uBE44\uC0C1\uACC4\uB2E8(\uBC29\uD654\uBB38)\uC73C\uB85C \uB300\uD53C\uD558\uC138\uC694. \uC774\uBBF8 \uAC07\uD614\uB2E4\uBA74 \uBAB8\uC744 \uB0AE\uCD94\uACE0 \uC816\uC740 \uC218\uAC74\uC73C\uB85C \uCF54\uC640 \uC785\uC744 \uB9C9\uC740 \uCC44 \uBE44\uC0C1 \uD638\uCD9C\uB85C \uC704\uCE58\uB97C \uC54C\uB9AC\uC9C0\uB9CC, \uAC00\uC7A5 \uC548\uC804\uD55C \uAC83\uC740 \uCC98\uC74C\uBD80\uD130 \uD0C0\uC9C0 \uC54A\uB294 \uAC83\uC785\uB2C8\uB2E4."
