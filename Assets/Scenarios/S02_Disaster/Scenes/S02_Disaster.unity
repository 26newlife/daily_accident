--- !u!114 &1718741622
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1718741617}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8df954fab8a08cc4498d5799a06cb25a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Scenarios.S02::GameGameplay.QuakeClues
  clues:
  - phase: 0
    delay: 3
    kind: 0
    text: "(\uCC3D\uBC16\uC73C\uB85C \uD3ED\uC6B0\uAC00 \uC3DF\uC544\uC9C4\uB2E4. \uBD88\uC5B4\uB09C \uAC15\uBB3C\uC774 \uAC70\uCE60\uAC8C \uD750\uB978\uB2E4...)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 1
    delay: 0.5
    kind: 0
    text: "(\uAC11\uC790\uAE30 \uBC14\uB2E5\uC774 \uD754\uB4E4\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4!)"
    skipIfDone: 
    sound: {fileID: 8300000, guid: 775f4ba55feb05944a7b01da91d5e413, type: 3}
    soundAt: {x: 3, y: 1.5, z: 4}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 2
    delay: 0.5
    kind: 1
    text: "[\uAE34\uAE09\uC7AC\uB09C\uBB38\uC790] \uC778\uADFC \uD574\uC5ED \uADDC\uBAA8 4.2 \uC9C0\uC9C4 \uBC1C\uC0DD\n\uB099\uD558\uBB3C\uB85C\uBD80\uD130 \uBAB8 \uBCF4\uD638, \uC9C4\uB3D9 \uBA48\uCD98 \uD6C4 \uAC00\uAE4C\uC6B4 \uC625\uC678\uB300\uD53C\uC7A5\uC18C\uB85C \uB300\uD53C\uD558\uBA70 \uC5EC\uC9C4 \uC8FC\uC758"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 2
    delay: 6
    kind: 2
    text: "\uBD80\uC5CC \uCABD\uC5D0\uC11C \uB9E4\uCE90\uD55C \uAC00\uC2A4 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4..."
    skipIfDone: gas_valve
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 2
    delay: 16
    kind: 0
    text: "(\uCC9C\uC7A5\uC5D0\uC11C \uBE57\uBB3C\uC774 \uB5A8\uC5B4\uC9C4\uB2E4. \uCF58\uC13C\uD2B8\uC5D0\uC11C '\uD0C1' \uD558\uACE0 \uBD88\uAF43\uC774 \uD280\uC5C8\uB2E4...)"
    skipIfDone: breaker
    sound: {fileID: 8300000, guid: 37638dc7f3ab8c64dab78a91dd929ec0, type: 3}
    soundAt: {x: 3, y: 0.3, z: 4.6}
    sparkAt: {x: 3, y: 0.3, z: 4.6}
  - phase: 2
    delay: 28
    kind: 0
    text: "(\uD604\uAD00 \uBB38\uD2C0\uC774 \uC090\uAC71\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB09C\uB2E4...)"
    skipIfDone: door
    sound: {fileID: 8300000, guid: 96f28e7d4c8ec5a44b7d6d2d4f5a584d, type: 3}
    soundAt: {x: 3, y: 1.2, z: 0.2}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 2
    delay: 50
    kind: 0
    text: "(\uBC14\uB2E5 \uC544\uB798\uC5D0\uC11C \uB0AE\uAC8C \uC6B0\uB974\uB989\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uCEE4\uC9C4\uB2E4...)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 4
    delay: 1.5
    kind: 0
    text: "(\uD754\uB4E4\uB9BC\uC774 \uBA48\uCDC4\uB2E4... \uC774 \uAC74\uBB3C \uC548\uC740 \uB354 \uC774\uC0C1 \uC548\uC804\uD558\uC9C0 \uC54A\uB2E4.)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 5
    delay: 0.3
    kind: 0
    text: "(\uB610 \uD754\uB4E4\uB9B0\uB2E4! \uC5EC\uC9C4\uC774\uB2E4!)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 5
    delay: 2
    kind: 1
    text: "[\uAE34\uAE09\uC7AC\uB09C\uBB38\uC790] \uC778\uADFC \uD574\uC5ED \uADDC\uBAA8 6.7 \uC9C0\uC9C4 \uBC1C\uC0DD\n\uC9C0\uC9C4\uD574\uC77C \uACBD\uBCF4 \uBC1C\uB839. \uAC15\uAC00\xB7\uD574\uC548 \uC811\uADFC \uAE08\uC9C0, \uC989\uC2DC \uB192\uC740 \uACF3\uC73C\uB85C \uB300\uD53C \uBC14\uB78D\uB2C8\uB2E4"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 6
    delay: 2
    kind: 0
    text: "(\uBA40\uB9AC\uC11C \uC0AC\uC774\uB80C\uC774 \uAE38\uAC8C \uC6B8\uB9B0\uB2E4...)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 6
    delay: 14
    kind: 0
    text: "(\uAC15\uBB3C\uC774 \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C \uBA40\uB9AC \uBE60\uC838\uB098\uAC00\uACE0 \uC788\uB2E4...)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  - phase: 6
    delay: 32
    kind: 0
    text: "(\uAC15 \uCABD\uC5D0\uC11C \uAD49\uC74C\uC774 \uBC00\uB824\uC628\uB2E4!)"
    skipIfDone: 
    sound: {fileID: 0}
    soundAt: {x: 0, y: 0, z: 0}
    sparkAt: {x: 0, y: -999, z: 0}
  alertSound: {fileID: 8300000, guid: 2a5cd41e66d68244ea1749a0980b6e9b, type: 3}
  alertSeconds: 8
  subtitleSeconds: 4.5
