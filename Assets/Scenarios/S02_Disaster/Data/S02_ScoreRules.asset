    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uCCAB \uD754\uB4E4\uB9BC \uB54C \uBAB8\uC744 \uBCF4\uD638\uD588\uB2E4."
    badText: "\uD754\uB4E4\uB9AC\uAE30 \uC2DC\uC791\uD558\uBA74 \uBC14\uB85C \uD2BC\uD2BC\uD55C \uD0C1\uC790 \uC544\uB798\uB85C \uB4E4\uC5B4\uAC00 \uBAB8\uC744 \uBCF4\uD638\uD55C\uB2E4."
  - id: gas
