    badText: "\uD754\uB4E4\uB9BC\uC774 \uBA48\uCD94\uBA74 \uAC00\uC2A4 \uBC38\uBE0C\uB97C \uC7A0\uAC00 \uD654\uC7AC\uB97C \uB9C9\uB294\uB2E4."
  - id: breaker
    label: "\uD754\uB4E4\uB9BC\uC774 \uBA48\uCD94\uBA74 \uC804\uAE30 \uCC28\uB2E8\uAE30\uB97C \uB0B4\uB9B0\uB2E4"
