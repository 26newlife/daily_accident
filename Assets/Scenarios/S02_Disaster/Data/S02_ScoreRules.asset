    badText: "\uD754\uB4E4\uB9BC\uC774 \uBA48\uCD94\uBA74 \uC804\uAE30 \uCC28\uB2E8\uAE30\uB97C \uB0B4\uB824 \uB204\uC804\uC744 \uB9C9\uB294\uB2E4."
  - id: door
    label: "\uBB38\uC744 \uC5F4\uC5B4 \uCD9C\uAD6C\uB97C \uD655\uBCF4\uD55C\uB2E4"
