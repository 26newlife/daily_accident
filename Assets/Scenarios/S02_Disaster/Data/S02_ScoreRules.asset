  rules:
  - id: cover_foreshock
    label: "\uD754\uB4E4\uB9B4 \uB54C\uB294 \uD0C1\uC790 \uC544\uB798\uB85C \uB4E4\uC5B4\uAC00 \uBAB8\uC744 \uBCF4\uD638\uD55C\uB2E4 (\uCCAB \uD754\uB4E4\uB9BC)"
    maxPoints: 10
