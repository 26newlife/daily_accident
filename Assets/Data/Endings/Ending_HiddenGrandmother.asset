  id: ending_hidden_grandmother
  endingName: "\uD568\uAED8 \uC0B4\uC544\uB0A8\uB2E4"
  description: "\uD63C\uC790 \uC6C0\uC9C1\uC600\uB2E4\uBA74 \uB354 \uBE68\uB790\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uD558\uC9C0\uB9CC \uB2F9\uC2E0\uC740 \uC774\uC6C3 \uD560\uBA38\uB2C8\uC758 \uC190\uC744 \uB193\uC9C0 \uC54A\uC558\uB2E4. \uB290\uB9B0 \uAC78\uC74C\uC5D0 \uBCF4\uD3ED\uC744 \uB9DE\uCD94\uACE0, \uC816\uC740 \uC218\uAC74\uC744 \uB098\uB204\uACE0, \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uB300\uD53C\uD588\uB2E4. \uBAA8\uB450\uAC00 \uC0B4\uC544\uB0A8\uC558\uB2E4."
  isSurvival: 1
  isHidden: 1
  routeLabel: "\uD788\uB4E0 \xB7 \uC774\uC6C3 \uB3D9\uD589 \uAD6C\uC870"
