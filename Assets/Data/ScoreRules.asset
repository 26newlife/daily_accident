  m_Script: {fileID: 11500000, guid: 4e0a0b62a85feea43b4e0e2cf277a463, type: 3}
  m_Name: ScoreRules
  m_EditorClassIdentifier: Assembly-CSharp::GameGameplay.ScoreRules
  rules:
  - id: valve_order
    label: "\uAC00\uC2A4 \uCC28\uB2E8 \uC21C\uC11C"
    maxPoints: 10
    kind: 2
    key: act1_fuse_close_order
    threshold: 1
    partialPoints: 5
    partialKey: act1_main_close_order
    partialThreshold: 0
    goodText: "\uC8FC\uBC29 \uD4E8\uC988\uCF55\uBD80\uD130 \uC7A0\uAC00 \uAC00\uC2A4 \uC720\uC785\uC744 \uBA3C\uC800 \uB9C9\uC558\uB2E4."
    badText: "\uAC00\uC2A4\uB294 \uC8FC\uBC29 \uC911\uAC04 \uBC38\uBE0C(\uD4E8\uC988\uCF55)\uB97C \uBA3C\uC800, \uC774\uC5B4\uC11C \uB2E4\uC6A9\uB3C4\uC2E4 \uBA54\uC778 \uBC38\uBE0C\uB97C \uC7A0\uADF8\uB294 \uC21C\uC11C\uAC00 \uC548\uC804\uD558\uB2E4."
  - id: ventilation
    label: "\uD658\uAE30 \uC644\uB8CC"
    maxPoints: 10
    kind: 1
    key: act1_ventilation_done_time
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uCC3D\uBB38 3\uAC1C\uB97C \uC5F4\uC5B4 \uB9DE\uD1B5\uD48D\uC73C\uB85C \uAC00\uC2A4\uB97C \uBE7C\uB0C8\uB2E4."
    badText: "\uAC00\uC2A4 \uB0C4\uC0C8\uAC00 \uB098\uBA74 \uCC3D\uBB38\uC744 \uC5F4\uC5B4 \uD658\uAE30\uD574\uC57C \uD55C\uB2E4. \uC7A0\uAE08\uC7A5\uCE58\uB97C \uD480\uACE0 \uAC70\uC2E4\xB7\uC8FC\uBC29\xB7\uC548\uBC29 \uCC3D\uBB38\uC744 \uBAA8\uB450 \uC5F4\uC790."
  - id: multitap
    label: "\uBA40\uD2F0\uD0ED \uCC98\uB9AC"
    maxPoints: 10
    kind: 1
    key: act1_multitap_handled_correctly
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uC8FC\uBCC0 \uAC00\uC5F0\uBB3C\uC744 \uCE58\uC6B0\uACE0 \uCF54\uB4DC \uBCF8\uCCB4\uB97C \uBF51\uC544 \uACFC\uC5F4\uB41C \uBA40\uD2F0\uD0ED\uC744 \uCC98\uB9AC\uD588\uB2E4."
    badText: "\uACFC\uC5F4\uB41C \uBA40\uD2F0\uD0ED\uC740 \uC804\uC6D0 \uC2A4\uC704\uCE58\uB97C \uB204\uB974\uC9C0 \uB9D0\uACE0 \uC8FC\uBCC0 \uAC00\uC5F0\uBB3C\uC744 \uCE58\uC6B4 \uB4A4 \uD50C\uB7EC\uADF8 \uBCF8\uCCB4\uB97C \uC7A1\uACE0 \uBF51\uC544\uC57C \uD55C\uB2E4."
  - id: no_danger
    label: "\uBC29\uC1A1 \uD6C4 \uC704\uD5D8 \uD589\uB3D9 \uC5C6\uC74C"
    maxPoints: 10
    kind: 4
    key: act1_danger_attempts_after_broadcast
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uAE34\uAE09 \uBC29\uC1A1 \uB4A4 \uC804\uB4F1\xB7\uAC00\uC804 \uC2A4\uC704\uCE58\uB97C \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    badText: "\uAC00\uC2A4 \uB204\uCD9C \uBC29\uC1A1 \uB4A4\uC5D0\uB294 \uC804\uB4F1\xB7\uAC00\uC804\xB7\uD654\uAE30 \uC870\uC791\uC744 \uD558\uBA74 \uC548 \uB41C\uB2E4. \uC791\uC740 \uBD88\uAF43\uB3C4 \uD3ED\uBC1C\uB85C \uC774\uC5B4\uC9C4\uB2E4."
  - id: peephole
    label: "\uBB38\uAD6C\uBA4D \uD655\uC778"
    maxPoints: 5
    kind: 1
    key: peephole_checked
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uBB38\uC744 \uC5F4\uAE30 \uC804\uC5D0 \uBB38\uAD6C\uBA4D\uC73C\uB85C \uBCF5\uB3C4\uB97C \uC0B4\uD3C8\uB2E4."
    badText: "\uBB38\uC744 \uC5F4\uAE30 \uC804\uC5D0 \uBB38\uAD6C\uBA4D\uC73C\uB85C \uBCF5\uB3C4 \uC0C1\uD669(\uC5F0\uAE30\xB7\uBD88\uBE5B)\uC744 \uBA3C\uC800 \uC0B4\uD53C\uC790."
  - id: handle_check
    label: "\uC190\uC7A1\uC774 \uC628\uB3C4 \uD655\uC778"
    maxPoints: 10
    kind: 1
    key: act2_handle_check_time
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uC190\uB4F1\uC73C\uB85C \uD604\uAD00 \uC190\uC7A1\uC774 \uC628\uB3C4\uB97C \uD655\uC778\uD55C \uB4A4 \uD589\uB3D9\uD588\uB2E4."
    badText: "\uBB38\uC744 \uC5F4\uAE30 \uC804\uC5D0\uB294 \uBC18\uB4DC\uC2DC \uC190\uB4F1\uC73C\uB85C \uC190\uC7A1\uC774 \uC628\uB3C4\uB97C \uD655\uC778\uD574\uC57C \uD55C\uB2E4. \uB728\uAC70\uC6B0\uBA74 \uC5F4\uC9C0 \uC54A\uB294\uB2E4."
  - id: towel
    label: "\uC816\uC740 \uC218\uAC74 \uC0AC\uC6A9"
    maxPoints: 10
    kind: 1
    key: act2_wet_towel_time
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uC816\uC740 \uC218\uAC74\uC73C\uB85C \uCF54\uC640 \uC785\uC744 \uB9C9\uC544 \uC5F0\uAE30\uB97C \uB9C9\uC558\uB2E4."
    badText: "\uC5F0\uAE30\uAC00 \uB098\uBA74 \uC816\uC740 \uC218\uAC74\uC73C\uB85C \uCF54\uC640 \uC785\uC744 \uB9C9\uC544\uC57C \uD55C\uB2E4. \uD654\uC7A5\uC2E4\uC5D0\uC11C \uC218\uAC74\uC744 \uC801\uC154 \uB450\uC790."
  - id: neighbor_grandmother
    label: "\uC774\uC6C3 \uAD6C\uC870 (\uD560\uBA38\uB2C8)"
    maxPoints: 10
    kind: 0
    key: evac_grandmother_with_player
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "1003\uD638 \uD560\uBA38\uB2C8\uB97C \uC124\uB4DD\uD574 \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uB300\uD53C\uD588\uB2E4."
    badText: "\uC5D8\uB9AC\uBCA0\uC774\uD130 \uC55E\uC758 \uD560\uBA38\uB2C8\uB97C \uC124\uB4DD\uD558\uACE0 \uC816\uC740 \uC218\uAC74\uC744 \uAC74\uB124 \uD568\uAED8 \uACC4\uB2E8\uC73C\uB85C \uB300\uD53C\uD560 \uC218 \uC788\uC5C8\uB2E4."
  - id: neighbor_youngman
    label: "\uC774\uC6C3 \uAD6C\uC870 (\uCCAD\uB144)"
    maxPoints: 5
    kind: 0
    key: act3_youngman_saved
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uC218\uAC74 \uC5C6\uC774 \uACC4\uB2E8\uC73C\uB85C \uB2EC\uB824\uAC00\uB358 \uCCAD\uB144\uC744 \uC124\uB4DD\uD574 \uD568\uAED8 \uB300\uD53C\uD588\uB2E4."
    badText: "\uC218\uAC74 \uC5C6\uC774 \uC5F0\uAE30 \uCC2C \uACC4\uB2E8\uC73C\uB85C \uB2EC\uB824\uAC00\uB294 \uC774\uC6C3\uC740 \uB9D0\uB824\uC57C \uD55C\uB2E4. \uC218\uAC74\uC744 \uB098\uB220 \uC8FC\uACE0 \uD568\uAED8 \uC6C0\uC9C1\uC774\uC790."
  - id: fire_doors
    label: "\uBC29\uD654\uBB38 \uB2EB\uAE30"
    maxPoints: 10
    kind: 0
    key: fire_door_managed
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uD604\uAD00\uBB38\uACFC \uBC29\uD654\uBB38\uC744 \uB2EB\uC544 \uC5F0\uAE30 \uD655\uC0B0\uC744 \uB2A6\uCDC4\uB2E4."
    badText: "\uC9C0\uB098\uC628 \uD604\uAD00\uBB38\xB7\uBC29\uD654\uBB38\uC740 \uB2EB\uC544\uC57C \uC5F0\uAE30\uAC00 \uB530\uB77C\uC624\uC9C0 \uBABB\uD55C\uB2E4. \uC5F4\uB9B0 \uBC29\uD654\uBB38\uC740 \uC5F0\uAE30\uC758 \uD1B5\uB85C\uAC00 \uB41C\uB2E4."
  - id: call119
    label: "119 \uC2E0\uACE0 \uC815\uD655\uB3C4"
    maxPoints: 10
    kind: 6
    key: call119_result
    threshold: 0
    partialPoints: 3
    partialKey: 
    partialThreshold: 0
    goodText: "119 \uC5D0 \"1004\uD638 \uB300\uD53C\uACF5\uAC04\"\uCC98\uB7FC \uC815\uD655\uD55C \uC704\uCE58\uB97C \uC54C\uB838\uB2E4."
    badText: "119 \uC5D0\uB294 \uD638\uC218\xB7\uCE35\xB7\uD604\uC7AC \uC788\uB294 \uC7A5\uC18C\uB97C \uC815\uD655\uD788 \uB9D0\uD574\uC57C \uAD6C\uC870\uAC00 \uBE68\uB77C\uC9C4\uB2E4. \uC704\uCE58\uB97C \uC798\uBABB \uB9D0\uD558\uAC70\uB098 \uC2E0\uACE0\uD558\uC9C0 \uC54A\uC73C\uBA74 \uAD6C\uC870\uAC00 \uB2A6\uC5B4\uC9C4\uB2E4."
  - id: no_elevator
    label: "\uC5D8\uB9AC\uBCA0\uC774\uD130 \uBBF8\uC0AC\uC6A9"
    maxPoints: 5
    kind: 4
    key: risk_elevator_attempts
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uD654\uC7AC \uC911 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB97C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC558\uB2E4."
    badText: "\uD654\uC7AC \uC911 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294 \uC815\uC804\xB7\uC2B9\uAC15\uB85C \uC5F0\uAE30\uB85C \uB9E4\uC6B0 \uC704\uD5D8\uD558\uB2E4. \uC808\uB300 \uC774\uC6A9\uD558\uC9C0 \uB9D0\uACE0 \uACC4\uB2E8\uC744 \uC4F0\uC790."
  - id: route_safe
    label: "\uC548\uC804\uD55C \uACBD\uB85C \uC120\uD0DD"
    maxPoints: 10
    kind: 0
    key: act4_route_safe
    threshold: 0
    partialPoints: 0
    partialKey: 
    partialThreshold: 0
    goodText: "\uC190\uC7A1\uC774 \uC628\uB3C4\xB7\uACC4\uB2E8 \uC5F0\uAE30\xB7\uBC29\uD654\uBB38 \uC0C1\uD0DC\uB97C \uC885\uD569\uD574 \uC548\uC804\uD55C \uACBD\uB85C\uB97C \uACE8\uB790\uB2E4."
    badText: "\uC190\uC7A1\uC774 \uC628\uB3C4\uC640 \uACC4\uB2E8 \uC5F0\uAE30\uB97C \uD655\uC778\uD574 \uADF8 \uC0C1\uD669\uC5D0\uC11C \uAC00\uB2A5\uD55C \uACBD\uB85C\uB97C \uACE8\uB77C\uC57C \uD55C\uB2E4. \uBD88\uAC00\uB2A5\uD55C \uACBD\uB85C\uB294 \uD070 \uC704\uD5D8\uC774 \uB530\uB978\uB2E4."
  - id: time
    label: "\uC18C\uC694 \uC2DC\uAC04"
    maxPoints: 5
    kind: 5
    key: 
    threshold: 420
    partialPoints: 2
    partialKey: 
    partialThreshold: 540
    goodText: "7\uBD84 \uC774\uB0B4\uC5D0 \uD0C8\uCD9C\uD588\uB2E4."
    badText: "\uD654\uC7AC\uC5D0\uC11C\uB294 \uD310\uB2E8\uACFC \uD589\uB3D9\uC774 \uBE60\uB97C\uC218\uB85D \uC548\uC804\uD558\uB2E4. \uB9DD\uC124\uC774\uB294 \uC2DC\uAC04\uC744 \uC904\uC5EC \uBCF4\uC790."
