  m_Script: {fileID: 11500000, guid: 30bf9b402dbf0124e993e0d757eb5a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuakeSurvival.Quake.ClueSchedule
  director: {fileID: 17029632}
  messages: {fileID: 320651431}
  clues:
  - phase: 0
    delay: 0.5
    isAlert: 0
    text: "WASD \uC774\uB3D9 / Shift \uB2EC\uB9AC\uAE30 / \uB9C8\uC6B0\uC2A4 \uC2DC\uC810 / F \uC0C1\uD638\uC791\uC6A9 / Ctrl \uC219\uC774\uAE30 / T \uD734\uB300\uD3F0(\uC9C0\uB3C4)"
  - phase: 0
    delay: 4
    isAlert: 0
    text: "(\uCC3D\uBC16\uC73C\uB85C \uD3ED\uC6B0\uAC00 \uC3DF\uC544\uC9C4\uB2E4. \uBC14\uB2E4\uAC00 \uAC70\uCE60\uB2E4...)"
  - phase: 1
    delay: 0.5
    isAlert: 0
    text: "(\uAC11\uC790\uAE30 \uBC14\uB2E5\uC774 \uD754\uB4E4\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4!)"
  - phase: 2
    delay: 0.5
    isAlert: 1
    text: "[\uAE34\uAE09\uC7AC\uB09C\uBB38\uC790] \uD574\uC548\uC2DC \uB3D9\uCABD \uD574\uC5ED \uADDC\uBAA8 4.2 \uC9C0\uC9C4 \uBC1C\uC0DD\n\uB099\uD558\uBB3C\uB85C\uBD80\uD130 \uBAB8 \uBCF4\uD638, \uC9C4\uB3D9 \uBA48\uCD98 \uD6C4 \uAC00\uAE4C\uC6B4 \uC625\uC678\uB300\uD53C\uC7A5\uC18C\uB85C \uB300\uD53C\uD558\uBA70 \uC5EC\uC9C4 \uC8FC\uC758"
  - phase: 2
    delay: 6
    isAlert: 0
    text: "(\uBD80\uC5CC \uCABD\uC5D0\uC11C \uB9E4\uCE90\uD55C \uB0C4\uC0C8\uAC00 \uB09C\uB2E4...)"
  - phase: 2
    delay: 16
    isAlert: 0
    text: "(\uCC9C\uC7A5\uC5D0\uC11C \uBE57\uBB3C\uC774 \uB5A8\uC5B4\uC9C4\uB2E4. \uCF58\uC13C\uD2B8\uC5D0\uC11C '\uD0C1' \uD558\uACE0 \uBD88\uAF43\uC774 \uD280\uC5C8\uB2E4...)"
  - phase: 2
    delay: 28
    isAlert: 0
    text: "(\uD604\uAD00 \uBB38\uD2C0\uC774 \uC090\uAC71\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB09C\uB2E4...)"
  - phase: 2
    delay: 50
    isAlert: 0
    text: "(\uBC14\uB2E5 \uC544\uB798\uC5D0\uC11C \uB0AE\uAC8C \uC6B0\uB974\uB989\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uCEE4\uC9C4\uB2E4...)"
  - phase: 3
    delay: 0.2
    isAlert: 0
    text: "(\uCF85! \uD6E8\uC52C \uB354 \uD070 \uD754\uB4E4\uB9BC\uC774 \uB36E\uCCE4\uB2E4!)"
  - phase: 4
    delay: 1.5
    isAlert: 0
    text: "(\uD754\uB4E4\uB9BC\uC774 \uBA48\uCDC4\uB2E4... \uC774 \uAC74\uBB3C \uC548\uC740 \uB354 \uC774\uC0C1 \uC548\uC804\uD558\uC9C0 \uC54A\uB2E4.)"
  - phase: 5
    delay: 0.3
    isAlert: 0
    text: "(\uB610 \uD754\uB4E4\uB9B0\uB2E4! \uC5EC\uC9C4\uC774\uB2E4!)"
  - phase: 5
    delay: 2
    isAlert: 1
    text: "[\uAE34\uAE09\uC7AC\uB09C\uBB38\uC790] \uD574\uC548\uC2DC \uB3D9\uCABD \uD574\uC5ED \uADDC\uBAA8 6.7 \uC9C0\uC9C4 \uBC1C\uC0DD\n\uC9C0\uC9C4\uD574\uC77C \uACBD\uBCF4 \uBC1C\uB839. \uD574\uC548\uAC00 \uC811\uADFC \uAE08\uC9C0, \uC989\uC2DC \uB192\uC740 \uACF3\uC73C\uB85C \uB300\uD53C \uBC14\uB78D\uB2C8\uB2E4"
  - phase: 6
    delay: 2
    isAlert: 0
    text: "(\uBA40\uB9AC\uC11C \uC0AC\uC774\uB80C\uC774 \uAE38\uAC8C \uC6B8\uB9B0\uB2E4...)"
  - phase: 6
    delay: 14
    isAlert: 0
    text: "(\uBC14\uB2F7\uBB3C\uC774 \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C \uBA40\uB9AC \uBE60\uC838\uB098\uAC00\uACE0 \uC788\uB2E4...)"
  - phase: 6
    delay: 32
    isAlert: 0
    text: "(\uBC14\uB2E4 \uCABD\uC5D0\uC11C \uAD49\uC74C\uC774 \uBC00\uB824\uC628\uB2E4!)"
